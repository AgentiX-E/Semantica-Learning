{
  "name": "semantica-ts",
  "version": "0.1.0",
  "description": "Graph-Native Infrastructure for Context and Accountable AI Systems — a TypeScript reimplementation of Semantica (BuildSemantica/semantica-agi).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "knowledge-graph",
    "context-graph",
    "decision-intelligence",
    "reasoning",
    "provenance",
    "graphrag",
    "ontology",
    "semantic",
    "rdf",
    "provenance",
    "entity-resolution"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
